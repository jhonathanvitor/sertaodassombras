APP_NAME="Sertão das Sombras"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_PORT=8080

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=sertaodassombras
DB_USERNAME=sertao
DB_PASSWORD=sertao_secret
DB_ROOT_PASSWORD=root_secret

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

# Configurações do jogo / edital (Sertão das Sombras)
SERTAO_TITLE="Sertão das Sombras"
SERTAO_STUDIO="Expiai"
SERTAO_VERSION="v1.0 - Build Oficial"
SERTAO_EMAIL="majonescode@gmail.com"
SERTAO_DOWNLOAD_WINDOWS="https://SEU-LINK-AQUI/SertaoDasSombras_v1.0_Windows.exe"
SERTAO_DOWNLOAD_LINUX="https://SEU-LINK-AQUI/SertaoDasSombras_v1.0_Linux.x86_64"
SERTAO_ITCH_URL="https://expiai.itch.io/sertao-das-sombras"
SERTAO_GITHUB_URL="https://github.com/SEU-USUARIO/sertao-das-sombras/releases"
SERTAO_YOUTUBE_ID="dQw4w9WgXcQ"
SERTAO_INSTAGRAM_URL="#"
SERTAO_YOUTUBE_URL="#"
SERTAO_TWITTER_URL="#"

VITE_APP_NAME="${APP_NAME}"

# Acesso ao painel (/login). Usado só para criar o primeiro admin.
